# -----------------------------------------------------------------------------
# erp-app runtime values
# -----------------------------------------------------------------------------
# These EXPO_PUBLIC_* values are compiled into the application and are visible
# to users. Add their production values to the EAS "production" environment.
# Never use EXPO_PUBLIC_* for passwords, signing keys, or storage credentials.
EXPO_PUBLIC_API_URL=http://localhost:3000/api
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
EXPO_PUBLIC_CENTRIFUGO_URL=ws://localhost:8000/connection/websocket

# Mobile release/update behavior.
EXPO_PUBLIC_RELEASE_CHANNEL=stable
EXPO_PUBLIC_RELEASE_CHECK_ENABLED=true
EXPO_PUBLIC_RELEASE_CHECK_INTERVAL_MS=21600000

# -----------------------------------------------------------------------------
# GitHub Actions secrets — configure in the erp-app GitHub repository
# -----------------------------------------------------------------------------
# These are documentation placeholders for .github/workflows/release-android.yml.
# Do not add real values to a committed file and do not expose them through
# EXPO_PUBLIC_* variables.
EXPO_TOKEN=replace_with_personal_expo_access_token
B2_ACCESS_KEY_ID=replace_with_bucket_scoped_backblaze_key_id
B2_SECRET_ACCESS_KEY=replace_with_bucket_scoped_backblaze_application_key

# -----------------------------------------------------------------------------
# GitHub Actions variables — configure in the erp-app GitHub repository
# -----------------------------------------------------------------------------
# Copy the S3-compatible endpoint and region from the Backblaze bucket details.
B2_ENDPOINT=https://s3.your-region.backblazeb2.com
B2_REGION=your-region
B2_BUCKET=erp-mobile-releases

# Public delivery root including the bucket name, with no trailing slash.
# The release workflow appends /releases/mobile/android/stable/... to this URL.
B2_PUBLIC_BASE_URL=https://f000.backblazeb2.com/file/erp-mobile-releases

# This path is currently fixed by the workflow. Change the workflow and Web-ERP
# manifest URL together if you need a different path.
RELEASE_KEY_PREFIX=releases/mobile/android/stable

# -----------------------------------------------------------------------------
# Web-ERP production value — configure in the Web-ERP deployment, not EAS
# -----------------------------------------------------------------------------
# Web-ERP reads this manifest at runtime and automatically shows the newest APK.
VITE_ANDROID_RELEASE_MANIFEST_URL=https://f000.backblazeb2.com/file/erp-mobile-releases/releases/mobile/android/stable/latest.json
